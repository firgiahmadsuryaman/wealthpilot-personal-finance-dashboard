# Salin berkas ini menjadi .env dan masukkan API key milikmu sendiri.
# Pastikan paket/licence Twelve Data mengizinkan quote SPY dan USD/IDR ditampilkan.
TWELVE_DATA_API_KEY=

# Cache server (detik). 60 detik memberi pembaruan lebih sering tetapi memakai kuota API lebih banyak.
# Interval ini bukan jaminan streaming tick-by-tick; batas sumber dan lisensi provider tetap berlaku.
SPY_CACHE_SECONDS=60
USDIDR_CACHE_SECONDS=900

# Aplikasi lokal menggunakan 127.0.0.1:8000.
# Jangan mengekspos server ke internet tanpa autentikasi, HTTPS, dan pemeriksaan keamanan.
