# Copy this file to .env and insert your own API key.
# You must choose a Twelve Data plan/license that permits displaying the data in your dashboard.
TWELVE_DATA_API_KEY=

# Data refresh intervals. SPY quote refresh is near-real-time polling, not tick-by-tick streaming.
SPY_CACHE_SECONDS=180
USDIDR_CACHE_SECONDS=900

# This starter binds to 127.0.0.1:8000 in run.bat; do not expose it publicly without authentication and security hardening.
